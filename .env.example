# Public site origin (no trailing slash). Used for canonical URLs, Open Graph, and JSON-LD.
# Production: https://www.3dboxstudio.com
NEXT_PUBLIC_SITE_ORIGIN=https://www.3dboxstudio.com

# Bump when replacing public/images/featured-image.jpg so social crawlers fetch the new asset.
NEXT_PUBLIC_OG_IMAGE_VERSION=2

# Meta app ID for fb:app_id (Facebook Sharing Debugger / Open Graph).
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Google Analytics Measurement ID (G-XXXXXXXX). Leave empty to disable.
# Used for page views, sign_up events, and campaign attribution reporting.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AWS S3 — share image storage (server-only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=3dboxstudio
# Optional CloudFront or custom CDN base (no trailing slash). Falls back to virtual-hosted S3 URL.
AWS_S3_PUBLIC_BASE_URL=
# Object key prefix for shared designs (default: shares/)
AWS_S3_SHARE_PREFIX=shares/

# Neon Postgres — pooled connection string (server-only)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Share link settings (server-only)
SHARE_TTL_DAYS=90
SHARE_MAX_PAYLOAD_BYTES=4500000

# Resend — transactional email for account verification (server-only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# From address for verification emails. Must be on a domain verified in Resend.
# For local testing you can use Resend's shared sender:
EMAIL_FROM=3D Box Studio <onboarding@resend.dev>

# Admin panel password (server-only). Required in production.
ADMIN_PASSWORD=3dboxstudio-admin
# Recipient for admin alerts (e.g. new user registrations).
ADMIN_EMAIL=kashanshah@hotmail.com

# Google OAuth — sign in with Google (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Defaults to {site origin}/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# TeknoBoards contact form (server-only). API key from Admin → API sites.
TEKNOBOARDS_API_KEY=
# Legacy alias for the API key (still supported).
TEKNOBOARD_FORM_SUBMISSION_TOKEN=
# Form ID from your TeknoBoards form configuration.
TEKNOBOARDS_FORM_ID=

# Cloudflare Turnstile — contact form bot protection.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Local testing dummy keys (always pass): 1x00000000000000000000AA /
# 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=